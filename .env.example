# Base de datos MySQL - Aiven (gratis)
DATABASE_URL="mysql://avnadmin:TU_PASSWORD@TU_HOST.aivencloud.com:24019/defaultdb?ssl-mode=REQUIRED"

# Email transaccional (opcional - welcome, verificación, retiros, ventas, anuncios)
# Proveedor activo: "smtp" (Gmail u otro), "brevo" o "resend". Si se omite, el
# orden automático es Brevo → SMTP → Resend.
# EMAIL_PROVIDER="smtp"
# EMAIL_FROM="Caskiuz Afiliados <rijarwow@gmail.com>"
#
# Opción 1 — SMTP (funciona desde Venezuela sin dominio propio; recomendado):
# En Gmail: activar Verificación en 2 pasos y crear una "Contraseña de aplicación"
# (myaccount.google.com → Seguridad → Contraseñas de aplicaciones). Límite ~500/día.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="rijarwow@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
#
# Opción 2 — Brevo (300/día gratis; requiere verificar un remitente en Senders).
# BREVO_API_KEY="xkeysib-xxxxxxxx"
#
# Opción 3 — Resend (3.000/mes; EXIGE un dominio propio verificado en
# resend.com/domains. Sin dominio solo puede enviar al correo del dueño).
# Cuando tengas dominio: EMAIL_PROVIDER="resend" y EMAIL_FROM="Caskiuz <contacto@tudominio.com>"
# RESEND_API_KEY="re_xxxxxxxx"

# Asistente de IA del sitio (opcional - Google AI Studio, plan gratis)
# Crear en https://aistudio.google.com/apikey y pegar aquí para activar el chat
# GEMINI_API_KEY="AQ.Ab8..."
# GEMINI_MODEL="gemini-2.5-flash"

# Cron de tasas de cambio (producción): secreto que usa Vercel Cron para
# llamar a /api/cron/rates. Generar uno aleatorio, ej: openssl rand -hex 32
# CRON_SECRET="..."

# Fuentes de tasas (opcional, solo si alguna cambia de URL):
# RATES_VES_URL="https://ve.dolarapi.com/v1/dolares/paralelo"
# RATES_COP_URL="https://www.dolar-colombia.com/"

# Demos en vivo de los proyectos (opcional - API de Vercel)
# Credencial: https://vercel.com/account/tokens → Create Token (scope: tu equipo).
# Con este token, la sección de Proyectos detecta automáticamente la URL de
# producción de cada repo desplegado en Vercel. Sin él, solo se muestran los
# repos que tengan el campo "Website/homepage" configurado en GitHub.
# VERCEL_TOKEN="..."
