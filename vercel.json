{
  "framework": "nextjs",
  "buildCommand": "npx prisma db push && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/rates",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/intelligence",
      "schedule": "0 13 * * *"
    }
  ],
  "github": {
    "silent": true
  }
}